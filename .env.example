# 服务监听
HOST=127.0.0.1
PORT=3000
# 允许的 Host（逗号分隔，不含端口）；HOST 为非回环地址时必填
ALLOWED_HOSTS=

# 数据库路径：相对路径以项目根目录解析；首次运行 npm run db:init 建库
DATABASE_PATH=data/team-plan.sqlite

# development / test / production
NODE_ENV=development

# 扩展功能开关；TASK-002 阶段必须全部为 0
ENABLE_PRIORITY=0
ENABLE_FILTERS=0
ENABLE_ORDERING=0
ENABLE_SHARING=0

# EDITOR_KEY 仅在 P2 分享功能（TASK-028）启用时使用，TASK-002 不读取
